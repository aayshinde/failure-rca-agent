# Pick ONE way to run the LLM agents:
#  a) free + local:  LLM_PROVIDER=ollama, CHAT_MODEL=qwen2.5:7b-instruct, EMBED_MODEL=ollama:nomic-embed-text   (needs `ollama serve`)
#  b) OpenAI:        LLM_PROVIDER=openai and a real OPENAI_API_KEY
#  c) no LLM at all: EMBED_MODEL=local and use the `rules` agent
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Model the agent uses. gpt-4o-mini is cheap; set gpt-3.5-turbo to match that model exactly.
CHAT_MODEL=gpt-4o-mini
# Model used as the groundedness judge in evaluation (ideally stronger than CHAT_MODEL)
JUDGE_MODEL=gpt-4o-mini
# text-embedding-3-small, or "local" for an offline hashing embedder (no API calls)
EMBED_MODEL=text-embedding-3-small
# faiss (default, file-based) or qdrant (embedded local store, or a server if QDRANT_URL is set)
VECTOR_BACKEND=faiss
QDRANT_URL=
